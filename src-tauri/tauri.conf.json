{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BILIdown",
  "version": "0.3.1",
  "identifier": "com.yungumax.bilidown",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/install-dir.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yungumax/BILIdown/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyRjkwOTc3QzgzNjg2OUUKUldTZWhqYklkd241OHAxZWIvZTJLRk43YjJOYWY4cEtyaVlSejdGMG9Pcld0ejFHV0FGMER3QmYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}